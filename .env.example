NEWAPI_BASE_URL=
NEWAPI_KEY=
NEWAPI_MODEL=gemini-3.1-pro-preview
YUNWU_BASE_URL=https://yunwu.ai/v1
YUNWU_API_KEY=
YUNWU_GEMINI_API_KEY=
YUNWU_GEMINI_CHAT_MODEL=gemini-3.5-flash
YUNWU_CLAUDE_CHAT_API_KEY=
YUNWU_CLAUDE_CHAT_MODEL=claude-opus-4-6
YUNWU_CLAUDE_MESSAGES_URL=https://yunwu.ai/v1/messages

# 原生联网搜索（可选）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=
DATABASE_URL=
USAGE_MONITOR_URL=
USAGE_MONITOR_INTERNAL_SECRET=
USAGE_MONITOR_USD_CNY_RATE=7.3
YUNWU_GROUP_MULTIPLIER=1
YUNWU_CLAUDE_GROUP_MULTIPLIER=1
NEWAPI_GROUP_MULTIPLIER=1

# 可选：向量 RAG（检索仍使用这个 OpenAI embedding）
RAG_ENABLED=false
RAG_OPENAI_BASE_URL=https://api.openai.com/v1
RAG_OPENAI_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_EMBEDDING_DIMENSIONS=1024
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.55
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=140

# 仅用于用户上传文档/图片/视频时转向量，不用于检索
UPLOAD_EMBEDDING_URL=https://api.openlux.ai/v1beta/models/gemini-embedding-2-preview:generateContent
UPLOAD_EMBEDDING_API_KEY=
UPLOAD_EMBEDDING_MODEL=gemini-embedding-2-preview
UPLOAD_EMBEDDING_DIMENSIONS=1536

# 腾讯云 COS：配置后，知识库/会话里的图片和视频会上传到 COS（文档仍存本地）
# Bucket 必须是 bucketname-appid，例如 kb-chat-1250000000
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
# 可选：CDN 或自定义域名，填了则用公开 URL，不再签临时链接
COS_PUBLIC_BASE_URL=
# 可选：私有桶签名有效期（秒），默认 3600
COS_SIGN_EXPIRES=3600
# 可选：对象前缀，默认 kb-chat
COS_KEY_PREFIX=kb-chat
# 可选：对象 ACL。大多数桶已关闭 ACL，请留空；只有桶允许 ACL 且要公开读时才填 public-read
COS_OBJECT_ACL=

WIKI_ADMIN_TOKEN=

# 主站 SSO
MAIN_APP_URL=
MAIN_APP_KB_CHAT_ENTRY_PATH=/bot/kb-chat
MAIN_APP_KB_CHAT_SSO_EXCHANGE_PATH=/api/kb-chat-sso/exchange
# 本地开发可改为 false，正式环境建议保持 true
REQUIRE_MAIN_APP_SSO=false
KB_CHAT_SESSION_SECRET=
KB_CHAT_SESSION_COOKIE_NAME=kb_chat_session
KB_CHAT_SESSION_TTL_MINUTES=720
